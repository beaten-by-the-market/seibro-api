\n","#-----------------------------------------------------------\n","import pandas as pd\n","import requests\n","from time import sleep\n","from datetime import timedelta, datetime\n","from tqdm.notebook import tqdm\n","!pip install xml-to-dict\n","from xml_to_dict import XMLtoDict\n","from tqdm.notebook import tqdm\n","from google.colab import userdata\n","# HTTPS 인증서 경고 무시\n","import warnings\n","warnings.filterwarnings('ignore', message='Unverified HTTPS request')\n","\n","!pip install opendartreader\n","import OpenDartReader\n","#OpenDartReader 연결\n","dart = OpenDartReader(userdata.get('opendart_personal')) # colab에서 제공하는 비번 저장기능사용"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"HOUxNEVd3frW","executionInfo":{"status":"ok","timestamp":1751540210505,"user_tz":-540,"elapsed":21327,"user":{"displayName":"정재광","userId":"14077697393430610391"}}},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# XML 파서 초기화\n","xd = XMLtoDict()\n","\n","# API 키 설정\n","api_key = userdata.get('seibro')\n","\n","# 11유가, 12코스닥\n","mkt_list = ['11', '12']\n","df_stock_cust = pd.DataFrame()\n","\n","for mkt in tqdm(mkt_list, desc=\"시장별 종목 데이터 수집\"):\n","    url = f'https://seibro.or.kr/OpenPlatform/callOpenAPI.jsp?key={api_key}&apiId=getShotnByMart&params=MART_TPCD:{mkt}'\n","    sleep(1)\n","    raw = requests.get(url)\n","    data_dict = xd.parse(raw.content.decode('utf-8'))\n","    data_list = data_dict['SeibroAPI']['vector']['data']\n","    records = []\n","    for item in data_list:\n","        record = {\n","            'SHOTN_ISIN': item['result']['SHOTN_ISIN']['@value'],\n","            'KOR_SECN_NM': item['result']['KOR_SECN_NM']['@value'],\n","            'ISSUCO_CUSTNO': item['result']['ISSUCO_CUSTNO']['@value']\n","        }\n","        records.append(record)\n","    df_stock_cust_loop = pd.DataFrame(records)\n","    df_stock_cust = pd.concat([df_stock_cust, df_stock_cust_loop])\n","\n","print(f\"종목코드 맵핑 완료: 총 {len(df_stock_cust)}개 종목\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":68,"referenced_widgets":["4e1d0aa1d34546f3a8b63ef1a817847b","ffe237132ba644fd8234bd6ac2e9c386","e9386d4ed145499699e85140bd935858","fa87200fbfe545b79aa8a74a7bc2834c","206545fc1f244ad2896ff8a124f3fd5f","7acbbfcb044d44268520701e71077fdc","9de4ed3703e2434fb63e05e67a717ccb","1227f89c74f74b60ab7e667bf70f9d87","e0869638ae214788b75dfe368fdaaed2","0900c07bcfde4aeeae2e318131c22386","0bc9179091df454a8e31ab6aa91d6876"]},"id":"yyVwD2C73p6j","executionInfo":{"status":"ok","timestamp":1751539540293,"user_tz":-540,"elapsed":6760,"user":{"displayName":"정재광","userId":"14077697393430610391"}}},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 종목코드 기준으로 마지막 자리가 0이어야 보통주\n","df_stock_cust_f = df_stock_cust[df_stock_cust['SHOTN_ISIN'].str.endswith('0')].reset_index(drop=True)\n","\n","# SHOTN_ISIN에서 종목코드 리스트 추출\n","stock_codes = df_stock_cust_f['SHOTN_ISIN'].unique().tolist()\n","\n","company_info_list = []\n","\n","for code in tqdm(stock_codes, desc=\"기업 개황정보 수집 진행 중\"):\n","    sleep(0.1)\n","    try:\n","        df_company = dart.company(code)\n","        df_company['stock_code'] = code\n","        company_info_list.append(df_company)\n","    except Exception as e:\n","        pass  # Raw API data and exceptions may contain credentials.\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":371,"referenced_widgets":["5cd88c83555c4273a9f0ad7c1dda1625","06043c066242460ab9fba6cc4ae90020","098c3996f92d425292beed65b601f518","09daabce504e40989d5ce27da75afd7c","47dfae54c4be4f88b984b137012249e2","7dd35872c641409fbe731a986bfb59a4","54ae684a371f404580f829a496e9227e","ad140421b5914755a0c0ef3659544920","93a043f5d8124795aa49d3b19da56113","1ce631a6e70944589b1b7de83a99e626","24c4541e91b041ce94d9ae48123fe2f8"]},"collapsed":true,"id":"TnmgcYuY6lnK","executionInfo":{"status":"error","timestamp":1751542318148,"user_tz":-540,"elapsed":1839880,"user":{"displayName":"정재광","userId":"14077697393430610391"}}},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# 수집한 기업개황 데이터프레임화하고 필요한 칼럼만 남기기\n","company_info_df = pd.DataFrame(company_info_list)[['stock_code','corp_cls', 'jurir_no', 'acc_mt']].rename(columns={'stock_code':'SHOTN_ISIN'})\n","\n","# 합치기\n","df_final = pd.merge(df_stock_cust_f, company_info_df, how = 'left', on = 'SHOTN_ISIN')"],"metadata":{"id":"djWQKXfi8g6Z","executionInfo":{"status":"ok","timestamp":1751542622077,"user_tz":-540,"elapsed":26,"user":{"displayName":"정재광","userId":"14077697393430610391"}}},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["df_final"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":423},"id":"3jhBihxeD5M6","executionInfo":{"status":"ok","timestamp":1751542622552,"user_tz":-540,"elapsed":27,"user":{"displayName":"정재광","userId":"14077697393430610391"}}},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["df_final.to_excel('KRX_TO_JURIRNO.xlsx')"],"metadata":{"id":"RO2Rb-eIEArK","executionInfo":{"status":"ok","timestamp":1751542657716,"user_tz":-540,"elapsed":476,"user":{"displayName":"정재광","userId":"14077697393430610391"}}},"execution_count":null,"outputs":[]},{"cell_type":"code","source":[],"metadata":{"id":"VeOaHVE-E_AO"},"execution_count":null,"outputs":[]}]}
