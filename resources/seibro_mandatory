ta_list = [data_list]\n","\n","        records = []\n","        for item in data_list:\n","            if 'result' in item:\n","                record = {}\n","                for k, v in item['result'].items():\n","                    if isinstance(v, dict) and '@value' in v:\n","                        record[k] = v['@value']\n","                    else:\n","                        record[k] = v\n","                records.append(record)\n","\n","        return pd.DataFrame(records)\n","    except Exception as e:\n","        pass  # Raw API data and exceptions may contain credentials.\n","        pass  # Raw API data and exceptions may contain credentials.\n","        raise\n","\n","\n","# 비어있는 데이터프레임과 에러 리스트 생성\n","df_data = pd.DataFrame()\n","error = []\n","\n","# 기준일 정보 받아오기\n","custno_list = list(df_stock_cust['ISSUCO_CUSTNO'].unique())\n","for custno in tqdm(custno_list, desc=\"기준일 정보 수집\"):\n","    try:\n","        df_loop = get_getstddt(custno, api_key, start_dt, end_dt)\n","        df_data = pd.concat([df_data, df_loop], ignore_index=True)\n","    except Exception as e:\n","        logging.error(f\"Error fetching data for custno: {custno} - {e}\")\n","        error.append(custno)\n","\n","# 에러 발생 시 재차 돌리기\n","MAX_RETRIES = 5\n","retry_count = 0\n","\n","while len(error) > 0 and retry_count < MAX_RETRIES:\n","    print(f\"\\n재시도 {retry_count + 1}/{MAX_RETRIES}: 남은 항목 {len(error)}개\")\n","    sleep(10 * (retry_count + 1))  # 재시도 횟수에 따라 지연 시간 증가\n","    current_errors = len(error)\n","\n","    for i in tqdm(range(current_errors), desc=f\"재시도 {retry_count + 1}\"):\n","        custno = error.pop(0)\n","        try:\n","            df_loop = get_getstddt(custno, api_key, start_dt, end_dt)\n","            df_data = pd.concat([df_data, df_loop], ignore_index=True)\n","        except Exception as e:\n","            logging.error(f\"Retry {retry_count + 1}: Error fetching data for custno: {custno} - {e}\")\n","            error.append(custno)\n","\n","    retry_count += 1\n","\n","if len(error) > 0:\n","    print(f\"⚠️ {len(error)}개 항목 수집 실패\")\n","\n","print(f\"기준일 정보 수집 완료: 총 {len(df_data)}개 항목\")\n","\n","# 정기총회만 거르기\n","df_data1 = df_data[df_data['RGT_RACD_NM'] == '정기총회']\n","print(f\"정기총회 기준일: {len(df_data1)}개 항목\")\n","\n","#-----------------------------------------------------------\n","print(\"\\n[3/4] 주총 정보 수집 중...\")\n","#-----------------------------------------------------------\n","# 주총 정보 받아오는 함수\n","def get_getshm_info(cust_no, api_key, std_dt):\n","    url = f'https://seibro.or.kr/OpenPlatform/callOpenAPI.jsp?key={api_key}&apiId=getGmeetInfo&params=ISSUCO_CUSTNO:{cust_no},RGT_STD_DT:{std_dt}'\n","    raw = requests.get(url)\n","\n","    try:\n","        data_dict = xd.parse(raw.content.decode('utf-8'))\n","        vector = data_dict.get('SeibroAPI', {}).get('vector', {})\n","        result = vector.get('@result', '0')\n","\n","        if result == '0':\n","            return pd.DataFrame()\n","\n","        data_list = vector.get('data', [])\n","        if not isinstance(data_list, list):\n","            data_list = [data_list]\n","\n","        records = []\n","        for item in data_list:\n","            if 'result' in item:\n","                record = {}\n","                for k, v in item['result'].items():\n","                    if isinstance(v, dict) and '@value' in v:\n","                        record[k] = v['@value']\n","                    else:\n","                        record[k] = v\n","                records.append(record)\n","\n","        return pd.DataFrame(records)\n","    except Exception as e:\n","        logging.error(f\"주총 정보 처리 오류 (custno: {cust_no}, std_dt: {std_dt}): {str(e)}\")\n","        content = raw.content.decode('utf-8')\n","        logging.error(f\"원시 응답: {content[:200]}...\")\n","        raise\n","\n","\n","# 비어있는 데이터프레임과 에러 리스트 생성\n","df_data_shm = pd.DataFrame()\n","error = []\n","error_std_dt = []\n","\n","# 주총 정보 받아오기\n","items = list(zip(df_data1['ISSUCO_CUSTNO'], df_