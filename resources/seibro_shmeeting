료: 총 14983개 항목\n","\n","데이터 수집이 모두 완료되었습니다.\n","\n","== 수집 결과 요약 ==\n","종목 코드 및 고객번호 매핑: 2749개\n","기준일 정보: 7791개\n","정기총회 기준일: 2587개\n","주총 정보: 2585개\n","주총 안건 정보: 14983개\n","디렉토리가 이미 존재함: /content/drive/MyDrive/rag_projects\n"]}],"source":["# HTTPS 인증서 경고 무시\n","import warnings\n","warnings.filterwarnings('ignore', message='Unverified HTTPS request')\n","\n","print(\"예탁결제원 API 데이터 수집 시작\")\n","\n","# XML 파서 초기화\n","xd = XMLtoDict()\n","\n","# API 키 설정\n","api_key = userdata.get('seibro')\n","\n","#-----------------------------------------------------------\n","print(\"\\n[1/4] 종목코드와 예탁원 고객코드 맵핑 중...\")\n","#-----------------------------------------------------------\n","# 11유가, 12코스닥, 14코넥스\n","mkt_list = ['11', '12']\n","df_stock_cust = pd.DataFrame()\n","\n","for mkt in tqdm(mkt_list, desc=\"시장별 종목 데이터 수집\"):\n","    url = f'http://seibro.or.kr/OpenPlatform/callOpenAPI.jsp?key={api_key}&apiId=getShotnByMart&params=MART_TPCD:{mkt}'\n","    sleep(1)\n","    raw = requests.get(url, verify=False)\n","    data_dict = xd.parse(raw.content.decode('utf-8'))\n","    data_list = data_dict['SeibroAPI']['vector']['data']\n","    records = []\n","    for item in data_list:\n","        record = {\n","            'SHOTN_ISIN': item['result']['SHOTN_ISIN']['@value'],\n","            'KOR_SECN_NM': item['result']['KOR_SECN_NM']['@value'],\n","            'ISSUCO_CUSTNO': item['result']['ISSUCO_CUSTNO']['@value']\n","        }\n","        records.append(record)\n","    df_stock_cust_loop = pd.DataFrame(records)\n","    df_stock_cust = pd.concat([df_stock_cust, df_stock_cust_loop])\n","\n","print(f\"종목코드 맵핑 완료: 총 {len(df_stock_cust)}개 종목\")\n","\n","#-----------------------------------------------------------\n","print(\"\\n[2/4] 기준일 정보 수집 중...\")\n","#-----------------------------------------------------------\n","# 대상기간 설정\n","start_dt = '20241201'\n","end_dt = '20250331'\n","\n","# 기준일 정보 받아오는 함수\n","def get_getstddt(cust_no, api_key, start_dt, end_dt):\n","    url = f'http://seibro.or.kr/OpenPlatform/callOpenAPI.jsp?key={api_key}&apiId=getStddtInfo&params=ISSUCO_CUSTNO:{cust_no},BEGIN_STD_DT:{start_dt},EXPRY_STD_DT:{end_dt}'\n","    raw = requests.get(url, verify=False)\n","\n","    try:\n","        data_dict = xd.parse(raw.content.decode('utf-8'))\n","        vector = data_dict.get('SeibroAPI', {}).get('vector', {})\n","        result = vector.get('@result', '0')\n","\n","        if result == '0':\n","            return pd.DataFrame()\n","\n","        data_list = vector.get('data', [])\n","        if not isinstance(data_list, list):\n","            data_list = [data_list]\n","\n","        records = []\n","        for item in data_list:\n","            if 'result' in item:\n","                record = {}\n","                for k, v in item['result'].items():\n","                    if isinstance(v, dict) and '@value' in v:\n","                        record[k] = v['@value']\n","                    else:\n","                        record[k] = v\n","                records.append(record)\n","\n","        return pd.DataFrame(records)\n","    except Exception as e:\n","        print(f\"custno {cust_no} 처리 중 오류: {str(e)}\")\n","        print(f\"원시 응답: {raw.content.decode('utf-8')[:200]}...\")\n","        raise\n","\n","\n","# 비어있는 데이터프레임과 에러 리스트 생성\n","df_data = pd.DataFrame()\n","error = []\n","\n","# 기준일 정보 받아오기\n","custno_list = list(df_stock_cust['ISSUCO_CUSTNO'].unique())\n","for custno in tqdm(custno_list, desc=\"기준일 정보 수집\"):\n","    try:\n","        df_loop = get_getstddt(custno, api_key, start_dt, end_dt)\n","        df_data = pd.concat([df_data, df_loop], ignore_index=True)\n","    except Exception as e:\n","        logging.error(f\"Error fetching data for custno: {custno} - {e}\")\n","        error.append(custno)\n","\n","# 에러 발생 시 재차 돌리기\n","MAX_RETRIES = 5\n","retry_count = 0\n","\n","while len(error) > 0 and retry_count < MAX_RETRIES:\n","    print(f\"\\n재시도 {retry_count + 1}/{MAX_RETRIES}: 남은 항목 {len(error)}개\")\n","    sleep(10 * (retry_count + 1))  # 재시도 횟수에 따라 지연 시간 증가\n","    current_errors = len(error)\n","\n","    for i in tqdm(range(current_errors), desc=f\"재시도 {retry_count + 1}\"):\n","        custno = error.pop(0)\n","        try:\n","            df_loop = get_getstddt(custno, api_key, start_dt, end_dt)\n","            df_data = pd.concat([df_data, df_loop], ignore_index=True)\n","        except Exception as e:\n","            logging.error(f\"Retry {retry_count + 1}: Error fetching data for custno: {custno} - {e}\")\n","            error.append(custno)\n","\n","    retry_count += 1\n","\n","if len(error) > 0:\n","    print(f\"⚠️ {len(error)}개 항목 수집 실패\")\n","\n","print(f\"기준일 정보 수집 완료: 총 {len(df_data)}개 항목\")\n","\n","# 정기총회만 거르기\n","df_data1 = df_data[df_data['RGT_RACD_NM'] == '정기총회']\n","print(f\"정기총회 기준일: {len(df_data1)}개 항목\")\n","\n","#-----------------------------------------------------------\n","print(\"\\n[3/4] 주총 정보 수집 중...\")\n","#-----------------------------------------------------------\n","# 주총 정보 받아오는 함수\n","def get_getshm_info(cust_no, api_key, std_dt):\n","    url = f'http://seibro.or.kr/OpenPlatform/callOpenAPI.jsp?key={api_key}&apiId=getGmeetInfo&params=ISSUCO_CUSTNO:{cust_no},RGT_STD_DT:{std_dt}'\n","    raw = requests.get(url, verify=False)\n","\n","    try:\n","        data_dict = xd.parse(raw.content.decode('utf-8'))\n","        vector = data_dict.get('SeibroAPI', {}).get('vector', {})\n","        result = vector.get('@result', '0')\n","\n","        if result == '0':\n","            return pd.DataFrame()\n","\n","        data_list = vector.get('data', [])\n","        if not isinstance(data_list, list):\n","            data_list = [data_list]\n","\n","        records = []\n","        for item in data_list:\n","            if 'result' in item:\n","                record = {}\n","                for k, v in item['result'].items():\n","                    if isinstance(v, dict) and '@value' in v:\n","                        record[k] = v['@value']\n","      